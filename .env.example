# Copia este archivo a .env SOLO para pruebas locales. Nunca subas .env a GitHub.
NODE_ENV=development
PORT=10000

# Postgres (en Render: "Internal Database URL")
DATABASE_URL=postgres://usuario:clave@localhost:5432/conectard
# Pon false solo si tu Postgres local no usa SSL
DATABASE_SSL=false

# OBLIGATORIOS en producción (usa valores largos y aleatorios)
SESSION_SECRET=cambia-esto-por-64-caracteres-aleatorios
ADMIN_KEY=cambia-esto-por-una-clave-larga

# IA (opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Opcional: orígenes permitidos si el HTML se sirve desde otro dominio (separados por coma)
CORS_ORIGIN=

# Opcional: crea un negocio de demostración (requiere contraseña de 8+ caracteres)
SEED_DEMO=false
DEMO_PASSWORD=
